{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The launcher's window: its own commands, a folder picker, and opening links in the browser",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/*" }]
    }
  ]
}
